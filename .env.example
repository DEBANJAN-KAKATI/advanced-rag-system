# Copy this file to `.env` and fill in what you need. Every setting is optional.

# ---------------------------------------------------------------- LLM
# Gemini (https://aistudio.google.com/apikey). Setting this enables Gemini for answers AND embeddings.
GEMINI_API_KEY=

# Or any OpenAI-compatible server, e.g. OpenAI, or a fully local Ollama:
#   LLM_PROVIDER=openai
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=llama3.1
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# auto | gemini | openai | none   (auto = gemini if GEMINI_API_KEY is set, else openai if configured)
LLM_PROVIDER=auto
# Default: gemini-flash-latest for Gemini (always the current Flash model), gpt-4o-mini for openai
# LLM_MODEL=
LLM_TEMPERATURE=0.2
# Rewrite questions into better search queries (1 extra small LLM call per question)
# (ENABLE_QUERY_REWRITE is accepted as an older name for this setting)
QUERY_REWRITE=true
# Suggest follow-up questions (generated in the same call as the answer)
SUGGEST_FOLLOWUPS=true

# ---------------------------------------------------------------- Embeddings
# auto | gemini | local | none   (auto = gemini if GEMINI_API_KEY is set, else local)
# Changing the embedding model is safe: the index is rebuilt automatically on next start.
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=gemini-embedding-001
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---------------------------------------------------------------- Retrieval
# cross-encoder | keyword | none | mmr | sentence-maxsim   (compared in docs/EVALUATION_REPORT.md)
# cross-encoder needs sentence-transformers; without it the app uses keyword and says so in /api/status
RERANK_STRATEGY=cross-encoder
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Cross-encoder relevance (0-1) below which a passage is treated as unrelated
MIN_RELEVANCE_SCORE=0.02
# structure | fixed | sentence | semantic
CHUNK_STRATEGY=structure
# Chunk sizes in characters
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
# Passages given to the LLM per answer style
TOP_K_CONCISE=4
TOP_K_MEDIUM=6
TOP_K_LONG=10

# ---------------------------------------------------------------- Server
HOST=127.0.0.1
PORT=8000
OPEN_BROWSER=true
MAX_UPLOAD_MB=50
# Comma-separated origins, only needed for a front-end on another origin
CORS_ORIGINS=
# RAG_DATA_DIR=./data
